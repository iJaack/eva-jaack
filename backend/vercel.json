{
  "version": 2,
  "buildCommand": "pnpm install",
  "outputDirectory": ".",
  "functions": {
    "api/index.ts": {
      "runtime": "nodejs22.x",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/.well-known/(.*)",
      "destination": "/public/.well-known/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.ts"
    }
  ]
}
