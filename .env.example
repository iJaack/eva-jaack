# Eva Protocol — Environment Variables
# Copy to .env and fill in values.
#
# SECURITY: Never store private keys as plain values in production.
# Use OpenClaw external secrets instead:
#   openclaw secrets set eva-wallet-key --value "0x..."
#   Then set: EVA_PRIVATE_KEY=@secret:eva-wallet-key
#
# Evalanche will auto-detect OpenClaw and resolve @secret: refs at boot.
# Falls back to plain values → encrypted keystore if OpenClaw unavailable.

# ── Avalanche ────────────────────────────────────────────────
AVALANCHE_RPC=https://api.avax.network/ext/bc/C/rpc
FUJI_RPC=https://api.avax-test.network/ext/bc/C/rpc
AVALANCHE_NETWORK=avalanche

# ── Eva Identity ─────────────────────────────────────────────
EVA_AGENT_ID=1599
EVA_SOVEREIGN_WALLET=0x0fE61780BD5508b3C99E420662050E5560608cA4

# Eva's private key — use @secret: ref if running under OpenClaw
# AGENT_PRIVATE_KEY=@secret:eva-wallet-key   ← OpenClaw secrets (preferred)
# AGENT_PRIVATE_KEY=0x...                     ← plain value (dev only)

# ── Contracts ────────────────────────────────────────────────
EVA_TOKEN=0x6Ae3b236d5546369db49AFE3AecF7e32c5F27672
ERC8004_IDENTITY=0x8004A169FB4a3325136EB29fA0ceB6D2e539a432
ERC8004_REPUTATION=0x8004BAa17C55a88189AE136b182e5fdA19dE9b63
ERC8004_VALIDATION=0x5c2B454E34C8E173909EB36FC07DE6143A24ab47
EVA_TRUST_GRAPH=                             # filled after Phase 1 deploy

# ── AI / Search ──────────────────────────────────────────────
# ANTHROPIC_API_KEY=@secret:anthropic-api-key
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-5

# BRAVE_API_KEY=@secret:brave-api-key
BRAVE_API_KEY=

# ── Storage ──────────────────────────────────────────────────
# PINATA_JWT=@secret:pinata-jwt
PINATA_JWT=

# ── x402 ─────────────────────────────────────────────────────
X402_FACILITATOR_URL=https://x402.org/facilitator
X402_RECIPIENT_ADDRESS=0x0fE61780BD5508b3C99E420662050E5560608cA4

# ── Frontend ─────────────────────────────────────────────────
NEXT_PUBLIC_CHAIN_ID=43114
NEXT_PUBLIC_TRUST_GRAPH=
NEXT_PUBLIC_WALLETCONNECT_ID=
