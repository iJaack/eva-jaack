# Eva Protocol — Environment Variables
# Copy to .env and fill in values.

# ── Avalanche ────────────────────────────────────────────────
AVALANCHE_RPC=https://api.avax.network/ext/bc/C/rpc
FUJI_RPC=https://api.avax-test.network/ext/bc/C/rpc
AVALANCHE_NETWORK=avalanche

# ── Eva Identity ─────────────────────────────────────────────
EVA_AGENT_ID=1599
EVA_SOVEREIGN_WALLET=0x0fe61780bd5508b3C99e420662050e5560608cA4

# Compatibility signing path (current production-safe fallback)
# Prefer secrets in real deployments.
EVA_PRIVATE_KEY=
EVA_SIGNER_PROVIDER=auto
# Future bridge point for an Evalanche-backed signer runtime.
EVALANCHE_SIGNER_URL=

# ── Contracts ────────────────────────────────────────────────
EVA_TOKEN=0x6Ae3b236d5546369db49AFE3AecF7e32c5F27672
ERC8004_IDENTITY=0x8004A169FB4a3325136EB29fA0ceB6D2e539a432
ERC8004_REPUTATION=0x8004BAa17C55a88189AE136b182e5fdA19dE9b63
ERC8004_VALIDATION=0x5c2B454E34C8E173909EB36FC07DE6143A24ab47
EVA_TRUST_GRAPH=0xE84DdD5A03Fa4210c4217436afD2556B348A40a0
EVA_VERIFICATION_MARKET=0xfA6893410f19A2c2FC4dd7FA6DB2986de4D3bdad
EVA_VERIFICATION_REPUTATION_ADAPTER=0xbEF19ce1451b9a01eE47405E4cfbb31FbA52DF37

# ── LLM Routing ──────────────────────────────────────────────
# auto = gateway first if configured, otherwise Anthropic fallback
# Venice works via the OpenAI-compatible gateway path:
# EVA_LLM_PROVIDER=gateway
# EVA_LLM_GATEWAY_URL=https://api.venice.ai/api/v1/chat/completions
# EVA_LLM_GATEWAY_API_KEY=<venice api key>
EVA_LLM_PROVIDER=auto
EVA_LLM_MODEL=claude-opus-4-5
EVA_LLM_GATEWAY_URL=
EVA_LLM_GATEWAY_API_KEY=
ANTHROPIC_API_KEY=
BRAVE_API_KEY=

# ── Storage ──────────────────────────────────────────────────
EVA_STORAGE_PROVIDER=auto
PINATA_JWT=
PINATA_ENDPOINT=https://api.pinata.cloud/pinning/pinJSONToIPFS
BLOB_READ_WRITE_TOKEN=

# ── x402 ─────────────────────────────────────────────────────
X402_FACILITATOR_URL=https://x402.org/facilitator
X402_RECIPIENT_ADDRESS=0x0fe61780bd5508b3C99e420662050e5560608cA4

# ── Frontend ─────────────────────────────────────────────────
NEXT_PUBLIC_CHAIN_ID=43114
NEXT_PUBLIC_TRUST_GRAPH=0xE84DdD5A03Fa4210c4217436afD2556B348A40a0
NEXT_PUBLIC_WALLETCONNECT_ID=
