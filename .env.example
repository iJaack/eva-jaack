# Eva Protocol - Environment Variables
# Copy to .env and fill in local values.

# Avalanche
AVALANCHE_RPC=https://api.avax.network/ext/bc/C/rpc
FUJI_RPC=https://api.avax-test.network/ext/bc/C/rpc
AVALANCHE_NETWORK=avalanche

# Eva identity
EVA_AGENT_ID=1599
EVA_SOVEREIGN_WALLET=0x0fe61780bd5508b3C99e420662050e5560608cA4

# Evalanche credential resolution is handled by Evalanche itself.
# Use OpenClaw secrets where possible; these env vars are local fallback inputs.
AGENT_PRIVATE_KEY=
AGENT_MNEMONIC=

# Contracts
EVA_THESIS_PROTOCOL=0x5eDBd1eea3228662326e60634E53AB8975D6641c

# Local thesis/prediction storage override
EVA_STORAGE_DIR=

# Durable thesis/prediction storage for serverless production
EVA_PREDICTION_STORAGE_BACKEND=auto
BLOB_READ_WRITE_TOKEN=
EVA_PREDICTION_BLOB_PATH=eva-predictions/index.json

# Alternative durable thesis/prediction storage for serverless production.
# Works with Vercel KV / Upstash Redis REST credentials.
KV_REST_API_URL=
KV_REST_API_TOKEN=
EVA_PREDICTION_KV_KEY=eva-predictions:index

# Frontend
NEXT_PUBLIC_CHAIN_ID=43114
NEXT_PUBLIC_WALLETCONNECT_ID=
