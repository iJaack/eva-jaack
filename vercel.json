{
  "version": 2,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "cd backend && pnpm run build",
  "outputDirectory": "public",
  "functions": {
    "api/index.ts": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/.well-known/(.*)", "destination": "/backend/public/.well-known/$1" },
    { "source": "/(.*)", "destination": "/api/index.ts" }
  ]
}
