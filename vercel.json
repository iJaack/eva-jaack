{
  "version": 2,
  "installCommand": "pnpm install --frozen-lockfile",
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/next"
    },
    {
      "src": "api/index.ts",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 60,
        "includeFiles": [
          "node_modules/.pnpm/tiny-secp256k1@2.2.4/node_modules/tiny-secp256k1/lib/secp256k1.wasm"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.ts?route=api&path=$1"
    },
    {
      "src": "/.well-known/(.*)",
      "dest": "/api/index.ts?route=well-known&path=$1"
    },
    {
      "src": "/health",
      "dest": "/api/index.ts?route=health"
    },
    {
      "src": "/article/([^/]+)",
      "dest": "/frontend/article/[id]?nxtPid=$1"
    },
    {
      "src": "/claims/x",
      "dest": "/frontend/claims/x"
    },
    {
      "src": "/claims/([^/]+)",
      "dest": "/frontend/claims/[claimId]?nxtPclaimId=$1"
    },
    {
      "src": "/curator/([^/]+)",
      "dest": "/frontend/curator/[address]?nxtPaddress=$1"
    },
    {
      "src": "/markets/([^/]+)",
      "dest": "/resolve?kind=market&id=$1",
      "continue": true
    },
    {
      "src": "/predictors/([^/]+)",
      "dest": "/resolve?kind=predictor&id=$1",
      "continue": true
    },
    {
      "src": "/thesis/([^/]+)",
      "dest": "/resolve?kind=thesis&id=$1",
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/$1"
    }
  ]
}
