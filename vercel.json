{
  "version": 2,
  "installCommand": "cd frontend && npm install",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.ts"
    },
    {
      "source": "/.well-known/:path*",
      "destination": "/api/index.ts"
    },
    {
      "source": "/health",
      "destination": "/api/index.ts"
    }
  ],
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/out"
}