{
  "version": 2,
  "installCommand": "pnpm install --frozen-lockfile",
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/next"
    },
    {
      "src": "api/index.ts",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 60
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.ts?route=api&path=$1"
    },
    {
      "src": "/.well-known/(.*)",
      "dest": "/api/index.ts?route=well-known&path=$1"
    },
    {
      "src": "/health",
      "dest": "/api/index.ts?route=health"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/$1"
    },
    {
      "handle": "filesystem"
    }
  ]
}
