{
  "version": 2,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "cd frontend && pnpm run build && cp -r .next ../.next-output",
  "outputDirectory": ".next-output",
  "functions": {
    "api/index.ts": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.ts" },
    { "source": "/.well-known/:path*", "destination": "/api/index.ts" },
    { "source": "/health", "destination": "/api/index.ts" }
  ]
}
