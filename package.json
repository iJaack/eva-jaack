{
  "name": "eva-protocol",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Eva Protocol monorepo",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "sync:abi": "node scripts/generate-eva-abi.mjs",
    "dev": "NEXT_TELEMETRY_DISABLED=1 pnpm --filter frontend dev",
    "build": "pnpm --filter frontend build",
    "lint": "pnpm --filter frontend lint",
    "typecheck": "pnpm --filter frontend typecheck",
    "test:backend": "pnpm --filter backend test",
    "test:e2e": "pnpm --filter frontend test:e2e",
    "smoke:deploy": "node scripts/smoke-deployment.mjs"
  },
  "dependencies": {
    "hono": "^4.12.8"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "overrides": {
      "tiny-secp256k1@<=1.1.6": ">=1.1.7",
      "@hpke/core@<=1.7.4": ">=1.7.5",
      "axios@>=1.0.0 <=1.13.4": ">=1.13.5",
      "minimatch@<3.1.3": ">=3.1.3",
      "minimatch@>=9.0.0 <9.0.6": ">=9.0.6",
      "minimatch@>=9.0.0 <9.0.7": ">=9.0.7",
      "minimatch@<3.1.4": ">=3.1.4"
    }
  },
  "overrides": {}
}
